ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
# Storefront API token used only by the server to create carts and obtain checkout URLs.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
DATABASE_URL=
APP_URL=http://localhost:3000
APP_PORT=3001
APP_ENV=development
# Store used when a request does not specify storeSlug.
DEFAULT_STORE_SLUG=giovetta-living
# Admin API token (min. 16 chars), sent as "Authorization: Bearer <APPROVAL_SECRET>".
# Generate e.g. with: openssl rand -hex 32
APPROVAL_SECRET=
# Comma-separated browser origins allowed by CORS. Defaults to APP_URL
# (+ http://localhost:3000 outside production).
CORS_ORIGINS=
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REDIRECT_URI=http://localhost:3001/allegro/oauth/callback
ALLEGRO_API_BASE_URL=https://api.allegro.pl.allegrosandbox.pl
ALLEGRO_AUTH_BASE_URL=https://allegro.pl.allegrosandbox.pl
